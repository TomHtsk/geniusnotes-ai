rules_version = '2';

// NoteCaptain database rules. This file is a COPY for reference: the live rules are the
// ones published in the Firebase console (Firestore Database > Rules). Keep both the same.
// The server (/api, firebase-admin) is not affected by these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // A signed-in user can read everything under their own account...
    match /users/{uid}/{document=**} {
      allow read: if signedIn() && request.auth.uid == uid;
    }
    // ...and write their own notes, folders, history and notebooks, but NOT the usage
    // counters and limits, which only the server may change.
    match /users/{uid}/{col}/{document=**} {
      allow write: if signedIn() && request.auth.uid == uid
                   && !(col in ['usage', 'ytLimit', 'rateLimit', 'uploads']);
    }

    // Shared notes: anyone with the link can open one (but nobody can list them all).
    // Only the signed-in owner can create, replace or delete a link. On an
    // "Edit together" link, anyone with the link may change the text and their cursor —
    // only those fields, and only in the expected shape and size (the content itself is
    // cleaned by js/safe-html.js before anyone's browser shows it).
    function guestEditOk() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['content', 'title', 'lastEditedAt', 'cursors', 'guestCount'])
        && (!('content' in d) || (d.content is string && d.content.size() <= 900000))
        && (!('title' in d) || (d.title is string && d.title.size() <= 200))
        && (!('cursors' in d) || (d.cursors is map && d.cursors.size() <= 50))
        && (!('guestCount' in d) || (d.guestCount is int && d.guestCount >= 0 && d.guestCount <= 1000))
        && (!('lastEditedAt' in d) || d.lastEditedAt is number);
    }
    match /shared_notes/{shareId} {
      allow get: if true;
      allow create: if signedIn() && request.resource.data.sharedBy == request.auth.uid;
      allow update: if (signedIn()
                        && resource.data.sharedBy == request.auth.uid
                        && request.resource.data.sharedBy == request.auth.uid)
                    || (resource.data.collaborative == true && guestEditOk());
      allow delete: if signedIn() && resource.data.sharedBy == request.auth.uid;
    }

    // "Who is here" markers for notebooks: { <uid>: { name, color, pageIdx, updatedAt } }.
    // Real (non-anonymous) accounts only, and each person may only add or change their OWN
    // entry (the key equal to their uid). Nobody can delete the whole document or anyone
    // else's entry. (Colours/names are made safe where they are shown — notebook.html.)
    function realUser() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    match /nb_presence/{nbId} {
      allow read: if realUser();
      allow create: if realUser() && request.resource.data.keys().hasOnly([request.auth.uid]);
      allow update: if realUser()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([request.auth.uid]);
    }

    // Everything else (site-wide counters, guest limits) is server-only.
  }
}
