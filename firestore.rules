rules_version = '2';

// NoteCaptain database rules. This file is a COPY for reference: the live rules are the
// ones published in the Firebase console (Firestore Database > Rules). Keep both the same.
// The server (/api, firebase-admin) is not affected by these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // A signed-in user can read everything under their own account...
    match /users/{uid}/{document=**} {
      allow read: if signedIn() && request.auth.uid == uid;
    }
    // ...and write their own notes, folders, history and notebooks, but NOT the usage
    // counters and limits, which only the server may change.
    match /users/{uid}/{col}/{document=**} {
      allow write: if signedIn() && request.auth.uid == uid
                   && !(col in ['usage', 'ytLimit', 'rateLimit', 'uploads']);
    }

    // Shared notes: anyone with the link can open one (but nobody can list them all).
    // Only the signed-in owner can create, replace or delete a link. On an
    // "Edit together" link, anyone with the link may change the text and their cursor.
    match /shared_notes/{shareId} {
      allow get: if true;
      allow create: if signedIn() && request.resource.data.sharedBy == request.auth.uid;
      allow update: if (signedIn()
                        && resource.data.sharedBy == request.auth.uid
                        && request.resource.data.sharedBy == request.auth.uid)
                    || (resource.data.collaborative == true
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['content', 'title', 'lastEditedAt', 'cursors', 'guestCount']));
      allow delete: if signedIn() && resource.data.sharedBy == request.auth.uid;
    }

    // "Who is here" markers for shared notebooks.
    match /nb_presence/{nbId} {
      allow read, write: if signedIn();
    }

    // Everything else (site-wide counters, guest limits) is server-only.
  }
}
